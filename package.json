{
	"name": "obsidian-pubmed-fetcher",
	"version": "1.2.3",
	"description": "Obsidian plugin to fetch article metadata from PubMed ID or DOI",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -p tsconfig.build.json -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"preversion": "node version-bump.mjs --preversion",
		"version": "node version-bump.mjs",
		"postversion": "git push && git push --tags",
		"release": "npm run lint && npm test && npm run build",
		"lint": "eslint **/*.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [],
	"author": "Svend Gundestrup",
	"license": "AGPL-3.0",
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@typescript-eslint/eslint-plugin": "^8.57.0",
		"@typescript-eslint/parser": "^8.57.0",
		"@vitest/coverage-v8": "^3.0.0",
		"esbuild": "^0.28.0",
		"eslint": "^9.20.0",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"obsidian": "1.13.1",
		"tslib": "^2.8.1",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
